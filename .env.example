# =============================================================================
# Pcap2Rule — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# =============================================================================
# LLM API Keys (use one or more depending on your setup)
# =============================================================================
# For local Qwen2-7B (vLLM/HuggingFace), these are optional
# For cloud/API-based LLM inference:

# OpenAI-compatible API (GPT-4o for synthetic data generation D1)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Qwen API (if using cloud-based Qwen)
QWEN_API_KEY=your-qwen-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# DeepSeek API (alternative LLM)
DEEPSEEK_API_KEY=sk-26ec7e7f6e694ce3b83efb5df0f5249e
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# =============================================================================
# vLLM Endpoint (for local LLM inference)
# =============================================================================
VLLM_ENDPOINT=http://localhost:8000/v1

# =============================================================================
# Model Paths
# =============================================================================
# QWEN_MODEL_PATH=/path/to/Qwen2-7B-Instruct  # or HuggingFace model ID
# BI_ENCODER_PATH=./checkpoints/bi_encoder/final
# XGBOOST_PATH=./checkpoints/xgboost/xgboost_model.pkl
# LORA_ADAPTER_PATH=./checkpoints/lora_adapters/final

# =============================================================================
# Experiment Tracking
# =============================================================================
WANDB_API_KEY=your-wandb-key-here
WANDB_PROJECT=pcap2rule

# =============================================================================
# CUDA Settings
# =============================================================================
# CUDA_VISIBLE_DEVICES=0
# PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
